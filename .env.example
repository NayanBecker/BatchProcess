# Copie para .env na raiz e preencha a senha SOMENTE no arquivo local.
# Node.js >=22.22.2 carrega .env; variáveis do processo têm precedência.
# Runtime e migrations leem a mesma configuração. Não use o banco original.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tcc_framework_test
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=0
DB_POOL_MAX=10
