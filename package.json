{
  "name": "batcheman",
  "version": "1.0.0",
  "description": "Sistema de processamento em lote via CLI",
  "license": "ISC",
  "author": "nayanbecker",
  "private": true,
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/unit/*.test.cjs",
    "test:integration": "node -r ts-node/register --test --test-concurrency=1 tests/integration/*.test.cjs",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
    "db:check": "ts-node src/db/migrate.ts check",
    "migrate": "ts-node src/db/migrate.ts latest",
    "migrate:rollback": "ts-node src/db/migrate.ts rollback"
  },
  "dependencies": {
    "knex": "^3.1.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}