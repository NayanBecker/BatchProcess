{
  "dashboard": {
    "title": "Batch Processing - Database Monitoring",
    "uid": "batch-db-monitoring",
    "version": 1,
    "timezone": "browser",
    "schemaVersion": 16,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "tags": [
      "batch",
      "database",
      "postgresql"
    ],
    "editable": true,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "Database Pool Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "database_pool_connections{state=\"total\"}",
            "legendFormat": "Total",
            "refId": "A"
          },
          {
            "expr": "database_pool_connections{state=\"available\"}",
            "legendFormat": "Available",
            "refId": "B"
          },
          {
            "expr": "database_pool_connections{state=\"waiting\"}",
            "legendFormat": "Waiting",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 8,
                  "color": "yellow"
                },
                {
                  "value": 9,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 2,
        "title": "Query Rate (queries/sec)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(database_queries_total[1m]))",
            "legendFormat": "Total QPS",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "qps",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 12,
          "h": 4
        }
      },
      {
        "id": 3,
        "title": "Query Duration Percentiles",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 1,
                  "color": "yellow"
                },
                {
                  "value": 5,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 6
        }
      },
      {
        "id": 4,
        "title": "Query Errors by Type",
        "type": "barchart",
        "targets": [
          {
            "expr": "sum by (error_type) (rate(database_errors_total[5m]))",
            "legendFormat": "{{error_type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 6,
          "h": 6
        }
      },
      {
        "id": 5,
        "title": "Active Batch Jobs",
        "type": "stat",
        "targets": [
          {
            "expr": "batch_jobs_active",
            "legendFormat": "Running Jobs",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 3,
                  "color": "yellow"
                },
                {
                  "value": 5,
                  "color": "red"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "No jobs"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 6,
        "title": "Batch Jobs by Status",
        "type": "barchart",
        "targets": [
          {
            "expr": "batch_jobs_by_status",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "orientation": "horizontal",
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 18,
          "y": 4,
          "w": 6,
          "h": 6
        }
      },
      {
        "id": 7,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[1m]))",
            "legendFormat": "Total RPS",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "req/s",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 0,
          "y": 10,
          "w": 12,
          "h": 6
        }
      },
      {
        "id": 8,
        "title": "HTTP Request Duration (p50, p95, p99)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 2,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          }
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 6
        }
      },
      {
        "id": 9,
        "title": "API Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "api_uptime_seconds",
            "legendFormat": "Uptime (seconds)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 3600,
                  "color": "yellow"
                },
                {
                  "value": 86400,
                  "color": "blue"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Restarted"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "gridPos": {
          "x": 12,
          "y": 10,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 10,
        "title": "Database Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"batch-api\"}",
            "legendFormat": "API Status",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 0.5,
                  "color": "red"
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Down"
                  },
                  "1": {
                    "text": "Up"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "gridPos": {
          "x": 12,
          "y": 14,
          "w": 6,
          "h": 4
        }
      },
      {
        "id": 11,
        "title": "Query Errors by Table",
        "type": "table",
        "targets": [
          {
            "expr": "sum by (table) (rate(database_errors_total[5m]))",
            "legendFormat": "{{table}}",
            "refId": "A"
          },
          {
            "expr": "sum by (table) (rate(database_queries_total[5m]))",
            "legendFormat": "{{table}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "showHeader": true
        },
        "gridPos": {
          "x": 12,
          "y": 18,
          "w": 12,
          "h": 4
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS",
          "name": "Alerts",
          "visibility": 2
        }
      ]
    }
  },
  "overwrite": true
}