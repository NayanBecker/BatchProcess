FROM node:22.22.2-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY dist/core/runtimeConfig.js dist/core/identifiers.js ./dist/core/
COPY observability/collector.cjs observability/start-collector.cjs observability/collector-runtime.cjs observability/collector.config.json ./observability/
USER node
EXPOSE 9464
CMD ["node","observability/start-collector.cjs","/run/batcheman/batcheman.config.local.json"]
